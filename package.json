{
  "name": "figma-plugin-font-variable-progression",
  "version": "0.1.0",
  "private": true,
  "description": "Figma plugin: progressive variable font axis values per letter",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
